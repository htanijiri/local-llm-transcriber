# macOS
.DS_Store

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# ローカル設定（パス・用語集など機微情報を含む）。共有用は config.example.toml を使う。
config.toml

# 構築用・記録用ドキュメント（システム本体ではない。個人情報も含むためGit管理しない）
PROJECT_BRIEF.md
REQUIREMENTS.md
SETUP_LOG.md
BUILD_RECORD.md
TODO.md

# 発表資料（社内向け・同僚名や会議内容を含むため公開リポジトリには載せない）
slides/

# Zenn記事・本の下書き（Zenn側で管理・公開するため、コードリポジトリには載せない）
articles/
books/

# 入出力データ（実音声・文字起こし・議事録）。実データはコミットしない。
data/inbox/*
data/transcripts/*
data/summaries/*
!data/**/.gitkeep
samples/

# launchd の watch ログ
logs/
